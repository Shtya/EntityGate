# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/entity-gate?sslmode=require"
BETTER_AUTH_SECRET="generate-a-64-char-random-hex-string"
BETTER_AUTH_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Riyadh"
# Password for the demo users created by `npm run db:seed` (min 10 chars)
SEED_USER_PASSWORD=""
# Local file storage for attachments (dev). Production uses an S3-compatible driver.
STORAGE_DIR="./storage"
# Optional: clamd for virus scanning uploads. Unset = scans are recorded as SKIPPED.
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# Development admin created by `npm run db:seed`. Change before ANY deployment; the seed refuses to run in production.
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_PASSWORD="123456"
# false = admins can skip 2FA enrollment locally. Ignored in production, where 2FA is always enforced.
AUTH_MFA_ENFORCED="false"
# 64 hex chars. Encrypts iqama and passport numbers. Losing it makes them unreadable: back it up separately.
ENCRYPTION_KEY=""
# Reminder email. Leave SMTP_URL empty to keep reminders in the app only.
SMTP_URL=""
MAIL_FROM="EntityGate <no-reply@example.com>"
# false stops the hourly reminder scheduler.
JOBS_ENABLED="true"
# Shown on printed invoices.
COMPANY_NAME="EntityGate"
COMPANY_VAT_NUMBER=""
COMPANY_CR_NUMBER=""
COMPANY_ADDRESS=""
# Prisma connections per app instance. Keep the total under your database pooler's limit.
DB_POOL_SIZE="5"
# First administrator for npm run db:bootstrap (production).
BOOTSTRAP_ADMIN_EMAIL=""
